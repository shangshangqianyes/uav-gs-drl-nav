<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="canyon_course">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ========================= -->
    <!--  50m x 20m winding canyon                                 -->
    <!--  S-shaped centerline + jagged rock walls + pillars, corridor navigation -->
    <!--  SPAWN=(0,0)  HOME=(4,0)  GOAL=(22.5,1.1)                 -->
    <!--  Straight section x in [-3,3] keeps homing corridor clear -->
    <!-- ========================= -->

    <scene>
      <ambient>0.50 0.38 0.28 1</ambient>
      <background>0.82 0.68 0.50 1</background>
      <shadows>1</shadows>
    </scene>

