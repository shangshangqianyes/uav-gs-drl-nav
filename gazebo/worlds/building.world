  <world name="building_course">

    <!-- Basic environment -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ========================= -->
    <!--  50m x 50m hard building cluster (high-density alleyways) -->
    <!--  Outer walls: x,y in [-25,25]                             -->
    <!--  PX4 spawn = (0,0)  HOMING = (5,0,4) [+X 5m]              -->
