    <!-- ================================================== -->
    <!--  Navigation markers (visual only, no collision, do not affect lidar) -->
    <!--  disc: cylinder r=1.5 x thickness 0.05, z=0.025    -->
    <!--  Letters: white box combinations (H = takeoff/landing, T = goal) -->
    <!--  Bright colors kept as functional ID marks, distinct from gray obstacles -->
    <!-- ================================================== -->

    <!-- start (homing): (0, 11) - green disc + white 'H' -->
    <model name="start_marker">
      <static>true</static>
      <pose>0 11 0 0 0 0</pose>
      <link name="link">
        <visual name="disc">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>1.5</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>0.0 0.8 0.2 1</ambient>
            <diffuse>0.0 0.8 0.2 1</diffuse>
            <specular>0.1 0.2 0.1 1</specular>
            <emissive>0.0 0.45 0.1 1</emissive>
          </material>
        </visual>
        <visual name="h_left">
          <pose>-0.3 0 0.1 0 0 0</pose>
          <geometry><box><size>0.25 1.4 0.1</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.5 0.5 0.5 1</emissive></material>
        </visual>
        <visual name="h_right">
          <pose>0.3 0 0.1 0 0 0</pose>
          <geometry><box><size>0.25 1.4 0.1</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.5 0.5 0.5 1</emissive></material>
        </visual>
        <visual name="h_mid">
          <pose>0 0 0.1 0 0 0</pose>
          <geometry><box><size>0.85 0.25 0.1</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.5 0.5 0.5 1</emissive></material>
        </visual>
      </link>
    </model>

