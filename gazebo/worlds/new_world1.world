<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="new_world1">
    <!-- ================================================== -->
    <!--  new_world1  "Cluttered Blocks"                    -->
    <!--                                                    -->
    <!--  25x25 m irregular obstacle field. All obstacles use one steel gray, -->
    <!--  position/size/height/yaw all varied, box + cylinder mix, -->
    <!--  forming a complex navigation environment of dense gaps and open spaces. -->
    <!--                                                    -->
    <!--  Design notes:                                     -->
    <!--   - Color: single steel gray (unified material)    -->
    <!--   - Shape: box + cylinder random mix               -->
    <!--   - Size: length/width 1.4~2.8 m, height 5~9.5 m varied -->
    <!--   - Yaw: random, breaks the grid feel              -->
    <!--   - Layout: asymmetric scatter, clusters and open spaces -->
    <!--                                                    -->
    <!--  All obstacle tops z > 4 m, blocking z=4 m cruise altitude. -->
    <!--  Navigation markers (start/goal) have no collision, do not affect lidar. -->
    <!--  Frame: ENU, unit m.                               -->
    <!-- ================================================== -->

    <!-- Basic environment -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ================================================== -->
    <!--  Obstacle group (unified steel gray, irregular scatter) -->
    <!--  material: ambient/diffuse mid gray, slight emissive to brighten -->
    <!--  pose = x y (z=length/2) 0 0 yaw                   -->
    <!--  box:    size = sx sy length                       -->
    <!--  cyl:    radius = r, length = length               -->
    <!-- ================================================== -->

    <!-- == North cluster (y>0, near takeoff/landing area, keep (0,11) radius 3 m clear) == -->
    <model name="obs_01">
      <static>true</static>
      <pose>3.2 5.1 3.5 0 0 0.30</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 1.6 7.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 1.6 7.0</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
            <specular>0.10 0.10 0.12 1</specular>
            <emissive>0.06 0.06 0.07 1</emissive>
          </material>
        </visual>
      </link>
    </model>
