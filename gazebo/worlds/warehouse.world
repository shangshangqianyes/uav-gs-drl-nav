<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="warehouse_course">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ========================= -->
    <!--  44m x 26m warehouse racks                              -->
    <!--  4 rack rows y=+/-4.5,+/-9, x in [-8,8], posts+shelves+cargo -->
    <!--  Central aisle |y|<3.9, SPAWN=(0,0) HOME=(5,0)          -->
    <!--  GOAL=(-20,11) NW corner clear area                     -->
    <!--  Top-layer cargo top ~5m > 4m flight altitude, cannot fly over -->
    <!-- ========================= -->

    <scene>
      <ambient>0.45 0.47 0.50 1</ambient>
      <background>0.60 0.63 0.68 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- Outer walls (perimeter) -->
    <model name="perim_s">
      <static>true</static>
      <pose>0.00 -13.00 4.0 0 0 0</pose>
      <link name="body">
        <collision name="c"><geometry><box><size>44.00 0.30 8.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>44.00 0.30 8.0</size></box></geometry>
          <material><ambient>0.35 0.38 0.42 1</ambient><diffuse>0.46 0.50 0.55 1</diffuse></material>
